{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      /* 계약 타입은 이 체크아웃 안에서 찾는다. `node_modules/@reborn/contracts`는 메인 저장소의 실제 경로로
         풀리는 심링크라서, 워크트리에서 `tsc`를 돌리면 다른 체크아웃의 `api.ts`를 검사한다.
         그러면 계약을 바꾼 워크트리가 이전 타입으로 통과하거나, 머지된 코드가 다른 체크아웃의 이전 타입 때문에 실패한다.
         `baseUrl`이 이 파일 옆이라 아래 경로는 워크트리 안으로 풀린다. 타입만 내보내는 패키지(`export type`)라 런타임 해석과 어긋나지 않는다. */
      "@reborn/contracts": ["../../packages/reborn-contracts/typescript/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

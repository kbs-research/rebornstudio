# /opt/rebornstudio/.env 판. 서버에만 있는 파일이고 CD는 이 파일을 만들지도 고치지도 않는다.
#
# 자원 값은 vCPU 8 · 메모리 32GB · 디스크 150GB 서버를 예로 채워 두었다.
# 서버가 다르면 아래 "자원" 절만 다시 계산한다. 산식은 docs/install.md에 있다.
#
#   cp env.example /opt/rebornstudio/.env && chmod 600 /opt/rebornstudio/.env
#
# 운영(서버)용 판이다. 개발(로컬) 판은 저장소 루트 `.env.example`이다.
# 각 키의 뜻과 표시(prod 필수·배포 전용 등)는 사전 `docs/env-catalog.md`에 있다. 여기 적는 키는
# 사전에도 있어야 하고, prod compose가 `${VAR:?}`로 요구하는 키와 사전의 `prod 필수` 키는 여기에도
# 있어야 한다(scripts/ci/check-env-catalog.py).

# ── 배포 ──────────────────────────────────────────────────────────────────────
# 이미지 이름의 앞부분. NCP Container Registry를 쓰면 콘솔의 레지스트리 상세에 적힌 주소
# (<이름>.kr.ncr.ntruss.com)를 그대로 쓴다. 서버에서 직접 빌드하면(build-images.sh) local처럼 아무 이름이나 쓴다.
# 비워 두면 compose가 이미지 주소를 만들지 못해 배포가 시작 단계에서 멈춘다.
IMAGE_REGISTRY=
# IMAGE_TAG는 배포 스크립트가 넘기므로 여기 적지 않는다(적으면 롤백이 헷갈린다).

# ── 자원 (예: 8 vCPU / 32GB / 150GB) ──────────────────────────────────────────
#
# CPU 8개를 이렇게 나눈다:
#   긴 작업 워커(worker-gpu) 4  |  postgres·redis·api·web·worker·worker-qc 4
#
# 변환이나 CPU로 도는 비식별화가 모든 코어를 쓰면 postgres 응답이 늦어지고 API 전체가 느려진다.
# 상한이 이 형상의 안전장치다.
GPU_WORKER_CPUS=4
# GPU 서버면 true. worker-gpu가 GPU 이미지(rebornstudio-worker-gpu)와 GPU 한 장을 쓴다.
# GPU와 NVIDIA Container Toolkit이 없는 서버에서 켜면 worker-gpu 컨테이너가 만들어지지 않는다.
GPU_ENABLED=
GPU_WORKER_CONCURRENCY=2     # celery -c : 변환 하나와 비식별화 하나
TRANSCODE_MAX_INFLIGHT=2     # 변환 투입 상한. 넘는 잡은 큐에서 기다린다
DEIDENT_MAX_INFLIGHT=1       # 비식별화 투입 상한. GPU 한 장이면 1
TRANSCODE_THREADS=2          # 변환 1건의 스레드 = GPU_WORKER_CPUS ÷ GPU_WORKER_CONCURRENCY
                             #   컨테이너의 nproc은 호스트 8을 보고하므로 비우면 스레드가 너무 많아진다

# 메모리 32GB. 이 DB는 메타데이터만 담아 작으므로 2GB면 대개 DB 전체가 RAM에 올라간다.
PG_SHARED_BUFFERS=2GB
# 브로커 큐 + 세션 + rate-limit. 잡 페이로드가 KB 단위라 2GB는 넉넉하다.
# 정책은 noeviction으로 고정한다. 넘치면 버리지 않고 거부해야 잡이 사라지지 않는다.
REDIS_MAXMEMORY=2gb

# 디스크 예산은 docs/install.md의 디스크 산식을 따른다. 큰 항목은 롤백용을 포함한 이미지 세 세트(GPU
# 이미지는 한 세트에 약 7GB)와 서버에서 빌드할 때의 빌드 캐시다. 업그레이드 뒤 `docker builder prune`으로 비운다.

# ── 오브젝트 스토리지·분석 (NCP) ─────────────────────────────────────────────
# NCP 주소·버킷·키·MI 워크스페이스는 이 파일에 두지 않는다. 화면의 자격증명 연결에 등록하고
# 프로젝트마다 분석 연동에서 고른다. 남은 S3_*·NCLOUD_*·MAIU_BASE_URL·MAIU_WORKSPACE_NAME·
# MAIU_PROJECT_ID 줄은 앱이 읽지 않으니 지운다.

# ── 백업 ──────────────────────────────────────────────────────────────────────
# 산출물 버킷과 다른 버킷을 쓴다. 라이프사이클 정책이 다르고, 산출물 버킷을 통째로
# 지우는 실수가 백업까지 지우면 안 된다.
#
# 필수다. 셋 중 하나라도 비면 deploy.sh가 배포를 시작하지 않는다.
# 주기 12시간, 보관 30일, 키 접두어 backups/postgres는 고정이다.
BACKUP_BUCKET=
# 백업 버킷 전용 키. 백업은 DB 없이 돌아 자격증명 연결을 읽지 못하므로 NCP 키가 env에 남는
# 유일한 곳이다. 앱은 이 키를 읽지 않는다.
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ── MAIU (NCP Media Intelligence) ─────────────────────────────────────────────
# 실제 MI를 부른다. 키·워크스페이스·분석 프로젝트는 프로젝트가 고른 분석 연결에서 온다.
MAIU_ENABLED=true
# MAIU_ENABLED=false(가짜 MI)로 운영 서버를 띄울 때만 true로 준다. 없으면 api·워커가 기동을 거부한다.
# ALLOW_FAKE_MAIU=false

# ── 시크릿 (32자 이상. prod validator가 짧은 값·기본값을 거부한다) ───────────
#   openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
# 연결 자격증명 암호화 키. 새로 넣는 서버라면 아무 값이나 새로 만들면 된다.
# 이 값만 바꾸면 이미 저장된 자격증명을 복호화할 수 없다. 바꿀 때는 이전 키를 아래 값에 옮기고
# 재암호화 명령을 돌린다(infra/deploy/README.md의 "자격증명 암호화 키 교체"). 키에는 쉼표를 쓰지 않는다.
CREDENTIALS_KEY=
# 키를 바꾸는 동안 복호에만 쓰는 이전 키(쉼표 구분). 평소에는 비워 둔다.
CREDENTIALS_KEY_PREVIOUS=

# ── 비식별화 ─────────────────────────────────────────────────────────────────
# 모델은 worker-gpu 안에서 돈다. 어댑터를 비우면 essential-yunet을 쓴다.
# DEIDENT_MODEL=

# ── 인코더 (선택) ────────────────────────────────────────────────────────────
# 비우면 NVENC로 시험 인코딩이 되는 서버에서만 NVENC를 쓴다. nvenc·libx264로 고정할 수 있다.
# TRANSCODE_ENCODER=
# ESSENTIAL_DEIDENT_ENCODER=

# ── 기타 ──────────────────────────────────────────────────────────────────────
# 비워도 prod다(config 기본값). local·test·dev로 바꾸지 않는다.
ENVIRONMENT=prod
# same-origin이 기본(web nginx가 /api를 스트립 프록시)이라 보통 비워 둔다.
# 앞단 TLS 프록시가 Host를 바꿔 넘기면 사용자가 여는 주소(https://…)를 적는다. 없으면 토큰 갱신이
# 403 origin_not_allowed로 거절되어 새로고침마다 로그인 화면으로 돌아간다.
CORS_ORIGINS=
# 연결 주소로 받지 않는 내부 호스트(루프백·링크 로컬·메타데이터·점 없는 이름) 가운데 예외로 받을
# 호스트 이름이나 IP. 쉼표로 나누고 정확히 같은 값만 연다. 사내 모델 서버는 사설 IP로 쓰면 비워 둔다.
# CONNECTION_HOST_ALLOWLIST=

# 운영 web CSP가 썸네일·영상 재생·업로드·파일 저장에 여는 저장소 출처(공백 구분, https://호스트[:포트]).
# 비우면 NCP 객체 저장소(https://kr.object.ncloudstorage.com)만 연다. 저장소 연결의 엔드포인트가 다르면
# 그 출처를 더한다. 형식이 틀리면 web이 시작하지 않고 배포의 헬스 확인이 실패한다.
CSP_STORAGE_ORIGINS=
# web이 X-Forwarded-For·X-Forwarded-Proto를 믿을 앞단 TLS 프록시(공백이나 쉼표 구분, IP 주소·CIDR).
# 로드밸런서가 TLS를 끝내면 그 대역, 같은 서버의 nginx·Caddy가 끝내면 host를 적는다. 비우면 아무도 믿지 않는다.
# 앞단이 있는데 비워 두면 https로 접속해도 토큰 갱신이 403으로 거절되어 새로고침마다 로그인 화면으로 돌아간다.
WEB_TRUSTED_PROXIES=
# web·api 전용 edge 네트워크의 서브넷. 서버의 다른 네트워크와 겹쳐 배포가 멈출 때만 바꾼다.
# EDGE_SUBNET=172.31.250.0/28

# 개발(로컬)용 판. `cp .env.example .env` 후 필요한 값만 고친다.
#
#   운영 서버 판은 infra/deploy/env.example이다.
#   키마다의 뜻과 표시(local·prod 필수 등)는 사전 docs/env-catalog.md에 있다.
#   여기 적는 키는 사전에 있어야 하고, 사전에서 `local`로 표시한 키는 여기 있어야 한다
#   (scripts/ci/check-env-catalog.py).
#
# NCP 저장소·MI 자격증명은 여기 넣지 않는다. 로컬 DB의 자격증명 연결에 등록하고 프로젝트가 고른다
# (docs/install.md의 "외부 서비스" 절). config는 저장소 루트의 `.env`를 읽고, 환경변수가 언제나 우선한다.

# ── 실행 환경 ─────────────────────────────────────────────────────────────────
# 지우지 않는다. 비우면 기본값 prod가 되어 아래 개발용 비밀값으로는 api·워커·스크립트가 뜨지 않는다.
ENVIRONMENT=local
# LOG_LEVEL=DEBUG

# ── DB · Redis ───────────────────────────────────────────────────────────────
# make dev-up이 띄우는 컨테이너 주소다. 호스트에서 직접 돌리면 localhost:5433·6380으로 바꾼다.
DATABASE_URL=postgresql+asyncpg://reborn:reborn@postgres:5432/rebornstudio
REDIS_URL=redis://redis:6379/0

# ── 인증 · 보안 ──────────────────────────────────────────────────────────────
# 로컬 자리표시값이다. ENVIRONMENT가 local·test가 아니면 기동을 거부한다.
JWT_SECRET=__change_in_prod__
JWT_REFRESH_SECRET=__change_in_prod__
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
# 로그인 세션의 절대 수명(일). refresh 교체로 늘어나지 않고, 지나면 다시 로그인한다.
JWT_SESSION_MAX_DAYS=14
# 자격증명 연결(NCP 키 등)을 로컬 DB에 암호화하는 키. 비우면 저장소에 적힌 고정 기본값을 쓰므로
# 로컬 DB나 그 덤프를 가진 사람은 누구나 저장한 NCP 키를 복호할 수 있다. 처음 세팅할 때 각자 난수로 만들어 넣는다.
# 만드는 법: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 주의: 이미 연결을 저장한 DB에서 키를 바꾸면 그 연결을 복호하지 못한다. 바꾼 뒤 연결의 시크릿을 다시 입력한다.
# 여러 사람이 같은 로컬 DB를 쓰면 키를 바꾸기 전에 함께 쓰는 사람과 맞춘다.
# CREDENTIALS_KEY=
# 키를 바꾸는 동안 복호에만 쓰는 이전 키(쉼표 구분). 절차는 infra/deploy/README.md의 "자격증명 암호화 키 교체" 절에 있다.
# CREDENTIALS_KEY_PREVIOUS=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── MAIU (NCP Media Intelligence) ────────────────────────────────────────────
# false면 가짜 분석이 응답한다. 실제 MI는 true로 바꾸고 자격증명 연결에 MI 연결을 등록한다.
MAIU_ENABLED=false
MAIU_SCENE_RANGE=MEDIUM
MAIU_PERSON_COUNT=0
MAIU_HTTP_TIMEOUT=30.0

# ── 비식별화 (선택) ──────────────────────────────────────────────────────────
# worker-gpu가 돌리는 비식별화 어댑터. 비우면 essential-yunet을 쓴다.
# DEIDENT_MODEL=

# ── 백업 (선택) ──────────────────────────────────────────────────────────────
# 운영은 늘 켜지만 개발은 채울 때만 make dev-up이 pg-backup도 띄운다(infra/deploy/profiles.sh).
# BACKUP_BUCKET=

# ── 개발 시드 (선택) ─────────────────────────────────────────────────────────
# make seed-dev의 장면 영상이 가리키는 저장소의 실제 장면 클립이다.
# 비워 두면 장면 영상을 만들지 않고 나머지 시드만 넣는다. 형식은 docs/env-catalog.md 개발 시드 절.
# SEED_SCENE_BUCKET=
# SEED_SCENE_CLIPS=
# SEED_MAIU_ARTIFACT_KEY=
